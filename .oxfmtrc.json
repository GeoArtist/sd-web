{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "printWidth": 80,
  "trailingComma": "all",
  "sortPackageJson": false,
  "overrides": [
    {
      "files": ["*.scss"],
      "options": {
        "tabWidth": 4
      }
    }
  ],
  "ignorePatterns": [
    ".next/",
    "out/",
    "build/",
    "node_modules/",
    "public/",
    "social-posts/",
    "src/content/",
    "next-env.d.ts",
    ".claude/",
    "package.json"
  ]
}
